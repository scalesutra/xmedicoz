generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SaaS Multi-Tenancy & Medical Shops
// ==========================================

model Shop {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  ownerName      String?   @map("owner_name")
  phone          String?
  email          String?
  drugLicenseNo  String?   @map("drug_license_no") // DL 20B, 21B
  gstin          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  invoicePrefix  String    @default("INV") @map("invoice_prefix")
  status         String    @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  members            ShopMember[]
  subscription       ShopSubscription?
  categories         Category[]
  manufacturers      Manufacturer[]
  units              Unit[]
  taxes              Tax[]
  medicines          Medicine[]
  customers          Customer[]
  suppliers          Supplier[]
  batches            MedicineBatch[]
  stockTransactions  StockTransaction[]
  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]
  purchaseReturns    PurchaseReturn[]
  supplierPayments   SupplierPayment[]
  salesInvoices      SalesInvoice[]
  salesReturns       SalesReturn[]
  refillRules        CustomerRefillRule[]
  followUps          CustomerFollowUp[]
  notifications      NotificationLog[]
  accountGroups      AccountGroup[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  expenses           Expense[]
  daybookRecords     DaybookRecord[]
  shortageDiaryItems ShortageDiaryItem[]
  auditLogs          AuditLog[]
  racks              Rack[]
  rackShelves        RackShelf[]
  rackBins           RackBin[]

  @@index([slug])
  @@index([status])
  @@map("shops")
}

model SubscriptionPlan {
  id                  String             @id @default(uuid())
  code                String             @unique // TRIAL, STARTER, PRO, ENTERPRISE
  name                String
  priceMonthly        Decimal            @default(0) @map("price_monthly") @db.Decimal(10, 2)
  priceYearly         Decimal            @default(0) @map("price_yearly") @db.Decimal(10, 2)
  maxUsers            Int                @default(2) @map("max_users")
  maxMedicines        Int                @default(500) @map("max_medicines")
  maxInvoicesPerMonth Int                @default(1000) @map("max_invoices_per_month")
  features            Json?
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  subscriptions       ShopSubscription[]

  @@map("subscription_plans")
}

model ShopSubscription {
  id           String           @id @default(uuid())
  shopId       String           @unique @map("shop_id")
  planId       String           @map("plan_id")
  status       String           @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, EXPIRED, CANCELLED
  billingCycle String           @default("MONTHLY") @map("billing_cycle") // MONTHLY, YEARLY
  startDate    DateTime         @default(now()) @map("start_date")
  endDate      DateTime         @map("end_date")
  autoRenew    Boolean          @default(true) @map("auto_renew")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  shop         Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([endDate])
  @@map("shop_subscriptions")
}

model ShopMember {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  userId    String   @map("user_id")
  role      String   @default("STAFF") // OWNER, PHARMACIST, CASHIER, STAFF
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("shop_members")
}

// ==========================================
// Phase 1: Authentication & User Models
// ==========================================

model User {
  id            String     @id @default(uuid())
  keycloakId    String     @unique @map("keycloak_id")
  email         String     @unique
  phone         String?    @unique
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  status        String     @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  avatarUrl     String?    @map("avatar_url")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  userRoles             UserRole[]
  shopMemberships       ShopMember[]
  auditLogs             AuditLog[]
  stockTransactions     StockTransaction[]
  purchaseOrders        PurchaseOrder[]
  purchaseInvoices      PurchaseInvoice[]
  purchaseReturns       PurchaseReturn[]
  supplierPayments      SupplierPayment[]
  salesInvoices         SalesInvoice[]
  salesReturns          SalesReturn[]
  createdRefillRules    CustomerRefillRule[]
  createdFollowUps      CustomerFollowUp[]
  createdJournalEntries JournalEntry[]
  createdExpenses       Expense[]
  createdDaybookRecords DaybookRecord[]

  @@index([email])
  @@index([phone])
  @@index([keycloakId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g., medicine.read, sales.invoice.create
  module      String           // auth, masters, inventory, sales, crm, accounting
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(uuid())
  shopId     String?  @map("shop_id")
  userId     String?  @map("user_id")
  action     String   // CREATE, UPDATE, DELETE, LOGIN, OTP_VERIFIED, PASSWORD_CHANGED
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  shop       Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// Phase 2: Master Management Models (Shop-Isolated)
// ==========================================

model Category {
  id          String     @id @default(uuid())
  shopId      String     @map("shop_id")
  name        String
  description String?
  status      String     @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  medicines   Medicine[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("categories")
}

model Manufacturer {
  id            String     @id @default(uuid())
  shopId        String     @map("shop_id")
  name          String
  contactPerson String?    @map("contact_person")
  email         String?
  phone         String?
  address       String?
  status        String     @default("ACTIVE")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  medicines     Medicine[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("manufacturers")
}

model Unit {
  id           String     @id @default(uuid())
  shopId       String     @map("shop_id")
  name         String     // e.g. Strip, Bottle, Box, Vial, Tube, Tablet
  abbreviation String?
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  medicines    Medicine[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("units")
}

model Tax {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  name      String   // e.g. GST 0%, GST 5%, GST 12%, GST 18%, GST 28%
  rate      Decimal  @db.Decimal(5, 2)
  cgst      Decimal  @default(0) @db.Decimal(5, 2)
  sgst      Decimal  @default(0) @db.Decimal(5, 2)
  igst      Decimal  @default(0) @db.Decimal(5, 2)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@index([shopId])
  @@map("taxes")
}

model Medicine {
  id                   String             @id @default(uuid())
  shopId               String             @map("shop_id")
  name                 String
  genericName          String             @map("generic_name")
  brand                String?
  dosageForm           String             @map("dosage_form") // Tablet, Capsule, Syrup, Injection, Ointment, Drops
  strength             String?            // 500mg, 650mg, 10ml, etc.
  hsnCode              String?            @map("hsn_code")
  gstRate              Decimal            @default(0) @map("gst_rate") @db.Decimal(5, 2)
  mrp                  Decimal            @db.Decimal(12, 2)
  purchaseRate         Decimal            @default(0) @map("purchase_rate") @db.Decimal(12, 2)
  sellingPrice         Decimal            @map("selling_price") @db.Decimal(12, 2)
  reorderLevel         Int                @default(10) @map("reorder_level")
  prescriptionRequired Boolean            @default(false) @map("prescription_required")
  rack                 String?
  shelf                String?
  box                  String?
  symptoms             String?
  saltComposition      String?            @map("salt_composition")
  otcFlag              Boolean            @default(false) @map("otc_flag")
  salesCount           Int                @default(0) @map("sales_count")
  status               String             @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  categoryId           String?            @map("category_id")
  manufacturerId       String?            @map("manufacturer_id")
  unitId               String?            @map("unit_id")
  rackId               String?            @map("rack_id")

  shop                 Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category             Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  manufacturer         Manufacturer?      @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  unit                 Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  rackRef              Rack?              @relation(fields: [rackId], references: [id], onDelete: SetNull)

  batches              MedicineBatch[]
  stockTransactions    StockTransaction[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  salesReturnItems     SalesReturnItem[]
  refillRules          CustomerRefillRule[]
  shortageDiaryItems   ShortageDiaryItem[]

  @@index([shopId])
  @@index([shopId, name])
  @@index([genericName])
  @@index([status])
  @@index([rackId])
  @@map("medicines")
}

model Customer {
  id                 String    @id @default(uuid())
  shopId             String    @map("shop_id")
  name               String
  mobile             String
  email              String?
  address            String?
  dob                DateTime?
  customerType       String    @default("REGULAR") @map("customer_type") // WALK_IN, REGULAR, PERMANENT
  isPermanent        Boolean   @default(false) @map("is_permanent")
  creditLimit        Decimal   @default(0) @map("credit_limit") @db.Decimal(12, 2)
  currentBalance     Decimal   @default(0) @map("current_balance") @db.Decimal(12, 2)
  notificationOptOut Boolean   @default(false) @map("notification_opt_out")
  status             String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  salesInvoices      SalesInvoice[]
  salesReturns       SalesReturn[]
  refillRules        CustomerRefillRule[]
  notifications      NotificationLog[]
  followUps          CustomerFollowUp[]

  @@unique([shopId, mobile])
  @@index([shopId])
  @@index([mobile])
  @@index([name])
  @@index([customerType])
  @@map("customers")
}

model Supplier {
  id                 String          @id @default(uuid())
  shopId             String          @map("shop_id")
  name               String
  contactPerson      String?         @map("contact_person")
  mobile             String
  email              String?
  gstin              String?
  dlNumber           String?         @map("dl_number") // Drug license number
  address            String?
  paymentTermsDays   Int             @default(30) @map("payment_terms_days")
  outstandingBalance Decimal         @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
  status             String          @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  batches            MedicineBatch[]
  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]
  purchaseReturns    PurchaseReturn[]
  supplierPayments   SupplierPayment[]
  shortageDiaryItems ShortageDiaryItem[]

  @@index([shopId])
  @@index([gstin])
  @@index([mobile])
  @@index([name])
  @@map("suppliers")
}

// ==========================================
// Phase 3: Inventory & Batch Management (Shop-Isolated)
// ==========================================

model MedicineBatch {
  id                String             @id @default(uuid())
  shopId            String             @map("shop_id")
  medicineId        String             @map("medicine_id")
  supplierId        String?            @map("supplier_id")
  batchNumber       String             @map("batch_number")
  manufacturingDate DateTime?          @map("manufacturing_date")
  expiryDate        DateTime           @map("expiry_date")
  mrp               Decimal            @db.Decimal(12, 2)
  purchaseRate      Decimal            @map("purchase_rate") @db.Decimal(12, 2)
  sellingPrice      Decimal            @map("selling_price") @db.Decimal(12, 2)
  currentQuantity   Int                @default(0) @map("current_quantity")
  status            String             @default("ACTIVE") // ACTIVE, NEAR_EXPIRY, EXPIRED, QUARANTINED
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  shop                 Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  medicine             Medicine              @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplier             Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockTransactions    StockTransaction[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  salesReturnItems     SalesReturnItem[]

  @@unique([shopId, medicineId, batchNumber])
  @@index([shopId])
  @@index([medicineId])
  @@index([expiryDate])
  @@index([status])
  @@index([batchNumber])
  @@map("medicine_batches")
}

model StockTransaction {
  id              String        @id @default(uuid())
  shopId          String        @map("shop_id")
  batchId         String        @map("batch_id")
  medicineId      String        @map("medicine_id")
  transactionType String        @map("transaction_type") // PURCHASE, SALE, RETURN_IN, RETURN_OUT, ADJUSTMENT_ADD, ADJUSTMENT_SUB, DAMAGE, OPENING
  quantityDelta   Int           @map("quantity_delta")
  balanceAfter    Int           @map("balance_after")
  referenceType   String?       @map("reference_type")
  referenceId     String?       @map("reference_id")
  notes           String?
  performedById   String?       @map("performed_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  batch           MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  medicine        Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  performedBy     User?         @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([batchId])
  @@index([medicineId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("stock_transactions")
}

// ==========================================
// Phase 4: Purchase Management (Shop-Isolated)
// ==========================================

model PurchaseOrder {
  id               String              @id @default(uuid())
  shopId           String              @map("shop_id")
  orderNumber      String              @map("order_number")
  supplierId       String              @map("supplier_id")
  orderDate        DateTime            @default(now()) @map("order_date")
  expectedDate     DateTime?           @map("expected_date")
  status           String              @default("PLACED") // DRAFT, PLACED, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  totalAmount      Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes            String?
  createdById      String?             @map("created_by_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  shop             Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy        User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items            PurchaseOrderItem[]
  invoices         PurchaseInvoice[]

  @@unique([shopId, orderNumber])
  @@index([shopId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  medicineId      String        @map("medicine_id")
  quantity        Int
  expectedRate    Decimal       @map("expected_rate") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine        Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@map("purchase_order_items")
}

model PurchaseInvoice {
  id               String                @id @default(uuid())
  shopId           String                @map("shop_id")
  invoiceNumber    String                @map("invoice_number") // Supplier's bill number
  internalNumber   String                @map("internal_number") // PI-YEAR-SEQ
  supplierId       String                @map("supplier_id")
  purchaseOrderId  String?               @map("purchase_order_id")
  invoiceDate      DateTime              @map("invoice_date")
  receivedDate     DateTime              @default(now()) @map("received_date")
  paymentTermsDays Int                   @default(30) @map("payment_terms_days")
  dueDate          DateTime?             @map("due_date")
  subtotal         Decimal               @db.Decimal(12, 2)
  discountAmount   Decimal               @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount        Decimal               @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount      Decimal               @map("total_amount") @db.Decimal(12, 2)
  paidAmount       Decimal               @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount    Decimal               @map("balance_amount") @db.Decimal(12, 2)
  paymentStatus    String                @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  status           String                @default("RECEIVED") // RECEIVED, CANCELLED
  notes            String?
  receivedById     String?               @map("received_by_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  shop             Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier         Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder    PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  receivedBy       User?                 @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  items            PurchaseInvoiceItem[]
  returns          PurchaseReturn[]
  payments         SupplierPayment[]

  @@unique([shopId, supplierId, invoiceNumber])
  @@unique([shopId, internalNumber])
  @@index([shopId])
  @@index([supplierId])
  @@index([invoiceDate])
  @@index([paymentStatus])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String          @id @default(uuid())
  purchaseInvoiceId String          @map("purchase_invoice_id")
  medicineId        String          @map("medicine_id")
  batchId           String          @map("batch_id")
  batchNumber       String          @map("batch_number")
  expiryDate        DateTime        @map("expiry_date")
  quantity          Int
  freeQuantity      Int             @default(0) @map("free_quantity")
  purchaseRate      Decimal         @map("purchase_rate") @db.Decimal(12, 2)
  mrp               Decimal         @db.Decimal(12, 2)
  sellingPrice      Decimal         @map("selling_price") @db.Decimal(12, 2)
  discountPercent   Decimal         @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRate           Decimal         @default(0) @map("tax_rate") @db.Decimal(5, 2)
  totalAmount       Decimal         @map("total_amount") @db.Decimal(12, 2)

  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  medicine          Medicine        @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch             MedicineBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("purchase_invoice_items")
}

model PurchaseReturn {
  id                String               @id @default(uuid())
  shopId            String               @map("shop_id")
  returnNumber      String               @map("return_number")
  supplierId        String               @map("supplier_id")
  purchaseInvoiceId String?              @map("purchase_invoice_id")
  returnDate        DateTime             @default(now()) @map("return_date")
  reason            String               // EXPIRED, DAMAGED, EXCESS, RECALLED
  totalAmount       Decimal              @map("total_amount") @db.Decimal(12, 2)
  status            String               @default("CONFIRMED") // DRAFT, CONFIRMED, CANCELLED
  createdById       String?              @map("created_by_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  shop              Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier          Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseInvoice   PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  createdBy         User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items             PurchaseReturnItem[]

  @@unique([shopId, returnNumber])
  @@index([shopId])
  @@index([supplierId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String         @id @default(uuid())
  purchaseReturnId String         @map("purchase_return_id")
  medicineId       String         @map("medicine_id")
  batchId          String         @map("batch_id")
  quantity         Int
  returnRate       Decimal        @map("return_rate") @db.Decimal(12, 2)
  totalAmount      Decimal        @map("total_amount") @db.Decimal(12, 2)

  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  medicine         Medicine       @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch            MedicineBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("purchase_return_items")
}

model SupplierPayment {
  id                String           @id @default(uuid())
  shopId            String           @map("shop_id")
  paymentNumber     String           @map("payment_number")
  supplierId        String           @map("supplier_id")
  purchaseInvoiceId String?          @map("purchase_invoice_id")
  paymentDate       DateTime         @default(now()) @map("payment_date")
  amount            Decimal          @db.Decimal(12, 2)
  paymentMode       String           @map("payment_mode") // CASH, BANK_TRANSFER, UPI, CHEQUE
  referenceNumber   String?          @map("reference_number")
  notes             String?
  createdById       String?          @map("created_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  shop              Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier          Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([shopId, paymentNumber])
  @@index([shopId])
  @@index([supplierId])
  @@index([paymentDate])
  @@map("supplier_payments")
}

// ==========================================
// Phase 5: Fast Sales POS & Revenue (Shop-Isolated)
// ==========================================

model SalesInvoice {
  id               String             @id @default(uuid())
  shopId           String             @map("shop_id")
  invoiceNumber    String             @map("invoice_number")
  customerId       String?            @map("customer_id")
  customerName     String?            @map("customer_name")
  customerMobile   String?            @map("customer_mobile")
  invoiceDate      DateTime           @default(now()) @map("invoice_date")
  subtotal         Decimal            @db.Decimal(12, 2)
  discountAmount   Decimal            @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount        Decimal            @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount      Decimal            @map("total_amount") @db.Decimal(12, 2)
  paidAmount       Decimal            @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount    Decimal            @default(0) @map("balance_amount") @db.Decimal(12, 2)
  paymentStatus    String             @default("PAID") // PAID, PARTIALLY_PAID, UNPAID
  doctorName       String?            @map("doctor_name")
  doctorRegNo      String?            @map("doctor_reg_no")
  notes            String?
  status           String             @default("COMPLETED") // COMPLETED, CANCELLED
  cashierId        String?            @map("cashier_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  shop             Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer         Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier          User?              @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  items            SalesInvoiceItem[]
  payments         SalesPayment[]
  returns          SalesReturn[]

  @@unique([shopId, invoiceNumber])
  @@index([shopId])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([customerMobile])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id             String        @id @default(uuid())
  salesInvoiceId String        @map("sales_invoice_id")
  medicineId     String        @map("medicine_id")
  batchId        String        @map("batch_id")
  batchNumber    String        @map("batch_number")
  quantity       Int
  unitPrice      Decimal       @map("unit_price") @db.Decimal(12, 2)
  mrp            Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)

  invoice        SalesInvoice  @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  medicine       Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch          MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("sales_invoice_items")
}

model SalesPayment {
  id              String       @id @default(uuid())
  salesInvoiceId  String       @map("sales_invoice_id")
  amount          Decimal      @db.Decimal(12, 2)
  paymentMode     String       @map("payment_mode") // CASH, UPI, CARD, CREDIT
  referenceNumber String?      @map("reference_number")
  createdAt       DateTime     @default(now()) @map("created_at")

  invoice         SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([salesInvoiceId])
  @@map("sales_payments")
}

model SalesReturn {
  id             String            @id @default(uuid())
  shopId         String            @map("shop_id")
  returnNumber   String            @map("return_number")
  salesInvoiceId String            @map("sales_invoice_id")
  customerId     String?           @map("customer_id")
  returnDate     DateTime          @default(now()) @map("return_date")
  totalAmount    Decimal           @map("total_amount") @db.Decimal(12, 2)
  refundMode     String            @map("refund_mode") // CASH, UPI, CREDIT_NOTE
  reason         String?
  createdById    String?           @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoice        SalesInvoice      @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items          SalesReturnItem[]

  @@unique([shopId, returnNumber])
  @@index([shopId])
  @@index([salesInvoiceId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String        @id @default(uuid())
  salesReturnId String        @map("sales_return_id")
  medicineId    String        @map("medicine_id")
  batchId       String        @map("batch_id")
  quantity      Int
  refundRate    Decimal       @map("refund_rate") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)

  salesReturn   SalesReturn   @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch         MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("sales_return_items")
}

// ==========================================
// Phase 6: Customer CRM & Refill Reminders (Shop-Isolated)
// ==========================================

model CustomerRefillRule {
  id                 String    @id @default(uuid())
  shopId             String    @map("shop_id")
  customerId         String    @map("customer_id")
  medicineId         String    @map("medicine_id")
  dailyDosage        Decimal   @default(1) @map("daily_dosage") @db.Decimal(5, 2)
  daysSupply         Int       @default(30) @map("days_supply")
  lastPurchaseDate   DateTime  @default(now()) @map("last_purchase_date")
  expectedRefillDate DateTime  @map("expected_refill_date")
  status             String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  notes              String?
  createdById        String?   @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  medicine           Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdBy          User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([customerId])
  @@index([medicineId])
  @@index([expectedRefillDate])
  @@index([status])
  @@map("customer_refill_rules")
}

model NotificationLog {
  id           String    @id @default(uuid())
  shopId       String    @map("shop_id")
  customerId   String?   @map("customer_id")
  channel      String    @map("channel") // WHATSAPP, SMS, EMAIL
  recipient    String
  templateName String    @map("template_name")
  message      String
  status       String    @default("SENT") // PENDING, SENT, FAILED
  errorReason  String?   @map("error_reason")
  scheduledFor DateTime? @map("scheduled_for")
  sentAt       DateTime  @default(now()) @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([customerId])
  @@index([status])
  @@index([sentAt])
  @@map("notification_logs")
}

model CustomerFollowUp {
  id             String    @id @default(uuid())
  shopId         String    @map("shop_id")
  customerId     String    @map("customer_id")
  followUpDate   DateTime  @map("follow_up_date")
  notes          String
  status         String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdById    String?   @map("created_by_id")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([customerId])
  @@index([followUpDate])
  @@index([status])
  @@map("customer_follow_ups")
}

// ==========================================
// Phase 7: Accounting & Daybook (Shop-Isolated)
// ==========================================

model AccountGroup {
  id          String    @id @default(uuid())
  shopId      String    @map("shop_id")
  code        String    // ASSETS, LIABILITIES, EQUITY, REVENUE, EXPENSES
  name        String
  type        String    // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  accounts    Account[]

  @@unique([shopId, code])
  @@index([shopId])
  @@map("account_groups")
}

model Account {
  id             String        @id @default(uuid())
  shopId         String        @map("shop_id")
  code           String        // e.g., 1010, 1020, etc.
  name           String
  type           String        // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  groupId        String        @map("group_id")
  description    String?
  isSystem       Boolean       @default(false) @map("is_system")
  currentBalance Decimal       @default(0) @map("current_balance") @db.Decimal(15, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  group          AccountGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  journalLines   JournalLine[]
  expenseAccounts Expense[]    @relation("ExpenseAccount")
  paidFromAccounts Expense[]   @relation("PaidFromAccount")

  @@unique([shopId, code])
  @@index([shopId])
  @@index([type])
  @@index([groupId])
  @@map("accounts")
}

model JournalEntry {
  id            String        @id @default(uuid())
  shopId        String        @map("shop_id")
  entryNumber   String        @map("entry_number")
  entryDate     DateTime      @default(now()) @map("entry_date")
  referenceType String        @default("MANUAL") @map("reference_type")
  referenceId   String?       @map("reference_id")
  narration     String
  status        String        @default("POSTED") // DRAFT, POSTED, VOID
  totalDebit    Decimal       @map("total_debit") @db.Decimal(15, 2)
  totalCredit   Decimal       @map("total_credit") @db.Decimal(15, 2)
  createdById   String?       @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         JournalLine[]
  expenses      Expense[]

  @@unique([shopId, entryNumber])
  @@index([shopId])
  @@index([entryDate])
  @@index([status])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String       @map("journal_entry_id")
  accountId      String       @map("account_id")
  type           String       // DEBIT, CREDIT
  amount         Decimal      @db.Decimal(15, 2)
  narration      String?

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Expense {
  id                String       @id @default(uuid())
  shopId            String       @map("shop_id")
  expenseNumber     String       @map("expense_number")
  expenseDate       DateTime     @default(now()) @map("expense_date")
  accountId         String       @map("account_id") // Debit Account
  paidFromAccountId String       @map("paid_from_account_id") // Credit Account
  amount            Decimal      @db.Decimal(15, 2)
  paymentMode       String       @default("CASH") @map("payment_mode")
  referenceNumber   String?      @map("reference_number")
  payee             String?
  description       String
  journalEntryId    String?      @map("journal_entry_id")
  createdById       String?      @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  shop              Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  account           Account      @relation("ExpenseAccount", fields: [accountId], references: [id], onDelete: Restrict)
  paidFromAccount   Account      @relation("PaidFromAccount", fields: [paidFromAccountId], references: [id], onDelete: Restrict)
  journalEntry      JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy         User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([shopId, expenseNumber])
  @@index([shopId])
  @@index([expenseDate])
  @@map("expenses")
}

model DaybookRecord {
  id            String    @id @default(uuid())
  shopId        String    @map("shop_id")
  date          DateTime  @db.Date
  openingCash   Decimal   @default(0) @map("opening_cash") @db.Decimal(15, 2)
  totalCashIn   Decimal   @default(0) @map("total_cash_in") @db.Decimal(15, 2)
  totalCashOut  Decimal   @default(0) @map("total_cash_out") @db.Decimal(15, 2)
  closingCash   Decimal   @default(0) @map("closing_cash") @db.Decimal(15, 2)
  openingBank   Decimal   @default(0) @map("opening_bank") @db.Decimal(15, 2)
  totalBankIn   Decimal   @default(0) @map("total_bank_in") @db.Decimal(15, 2)
  totalBankOut  Decimal   @default(0) @map("total_bank_out") @db.Decimal(15, 2)
  closingBank   Decimal   @default(0) @map("closing_bank") @db.Decimal(15, 2)
  notes         String?
  isClosed      Boolean   @default(false) @map("is_closed")
  closedAt      DateTime? @map("closed_at")
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([shopId, date])
  @@index([shopId])
  @@index([date])
  @@map("daybook_records")
}

// ==========================================
// Phase 8 / Retail Utilities: Shortage Diary (Kami Register / Want Book)
// ==========================================

model ShortageDiaryItem {
  id                  String    @id @default(uuid())
  shopId              String    @map("shop_id")
  medicineId          String    @map("medicine_id")
  customerCount       Int       @default(1) @map("customer_count")
  lastRequestedAt     DateTime  @default(now()) @map("last_requested_at")
  currentStock        Int       @default(0) @map("current_stock")
  suggestedReorderQty Int       @default(20) @map("suggested_reorder_qty")
  preferredSupplierId String?   @map("preferred_supplier_id")
  status              String    @default("PENDING") // PENDING, PO_CREATED, RESOLVED, DISMISSED
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  shop                Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  medicine            Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  @@unique([shopId, medicineId])
  @@index([shopId])
  @@index([status])
  @@index([lastRequestedAt])
  @@map("shortage_diary_items")
}

// ==========================================
// Phase 9 / Retail Storage: Rack & Shelf Management
// ==========================================

model Rack {
  id           String      @id @default(uuid())
  shopId       String      @map("shop_id")
  code         String      // e.g. "A", "B", "C-COLD"
  name         String      // e.g. "Front Antibiotics Rack"
  zone         String      @default("MAIN_COUNTER") // MAIN_COUNTER, BACK_STORAGE, COLD_STORAGE, NARCOTICS_LOCKER, OTC_FLOOR, GENERAL
  storageType  String      @default("STANDARD") @map("storage_type") // STANDARD, REFRIGERATED, NARCOTICS_SAFE, HAZARDOUS
  description  String?
  totalShelves Int         @default(4) @map("total_shelves")
  qrCode       String?     @map("qr_code")
  rowNumber    Int?        @map("row_number")
  columnNumber Int?        @map("column_number")
  status       String      @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  shop         Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shelves      RackShelf[]
  medicines    Medicine[]

  @@unique([shopId, code])
  @@index([shopId])
  @@index([zone])
  @@index([status])
  @@map("racks")
}

model RackShelf {
  id           String    @id @default(uuid())
  shopId       String    @map("shop_id")
  rackId       String    @map("rack_id")
  shelfNumber  Int       @map("shelf_number")
  shelfLabel   String?   @map("shelf_label")
  barcode      String?
  maxCapacity  Int?      @default(100) @map("max_capacity")
  temperature  Decimal?  @db.Decimal(4, 1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rack         Rack      @relation(fields: [rackId], references: [id], onDelete: Cascade)
  bins         RackBin[]

  @@unique([rackId, shelfNumber])
  @@index([shopId])
  @@index([rackId])
  @@map("rack_shelves")
}

model RackBin {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  shelfId     String   @map("shelf_id")
  binCode     String   @map("bin_code")
  capacity    Int?     @default(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shelf       RackShelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)

  @@unique([shelfId, binCode])
  @@index([shopId])
  @@index([shelfId])
  @@map("rack_bins")
}
