# Server Configuration
PORT=5095
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medicalcrm?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3
REDIS_KEY_PREFIX=mcrm:

# Keycloak Configuration
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_PUBLIC_URL=https://identity.cognoflux.com
KEYCLOAK_REALM=medicalcrm
KEYCLOAK_CLIENT_ID=medicalcrm-api
KEYCLOAK_CLIENT_SECRET=change_me
KEYCLOAK_WEB_CLIENT_ID=medicalcrm-web

# Keycloak Admin Credentials
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_SECONDS=600
OTP_DIGITS=6

# Providers (SMS / Email)
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
