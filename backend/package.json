{
  "name": "medicalcrm-backend",
  "version": "1.0.0",
  "description": "Medical Store Management & CRM System API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
